<?xml version="1.0" encoding="utf-8"?>
<!-- racine : la conversation (contenu), l'ecran de l'oeil par-dessus quand il est ouvert, et la vague (transition) tout en haut -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/racine"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fond">

<LinearLayout
    android:id="@+id/contenu"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="18dp"
    android:background="@color/fond">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/titre"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="26dp"
            android:src="@drawable/titre_archi"
            android:scaleType="fitStart"
            android:adjustViewBounds="true"
            android:contentDescription="Archi"
            android:clickable="true"
            android:focusable="true" />
        <fr.archi.telephone.IconeBluetooth
            android:id="@+id/lunettes"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:id="@+id/plus"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/cadre"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/vert"
            android:textSize="24sp"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Envoyer un document ou une photo" />
        <TextView
            android:id="@+id/etat"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text=""
            android:textColor="@color/texte2"
            android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <fr.archi.telephone.Sphere
            android:id="@+id/sphere"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="Parler à Archi" />
    </FrameLayout>

    <!-- la boite question / reponse : cachee (seulement pour le diagnostic ou si la voix ne marche pas) -->
    <ScrollView
        android:id="@+id/boite"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:background="@drawable/cadre"
        android:padding="14dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/entendu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texte2"
                android:textSize="13sp"
                android:textStyle="italic" />
            <TextView
                android:id="@+id/reponse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/texte"
                android:textSize="16sp"
                android:textIsSelectable="true" />
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/piece"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/cadre"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:textColor="@color/vert"
        android:textSize="14sp"
        android:maxLines="1"
        android:ellipsize="middle"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">
        <EditText
            android:id="@+id/saisie"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/cadre"
            android:hint="Écrire à Archi…"
            android:textColorHint="@color/texte2"
            android:textColor="@color/texte"
            android:padding="12dp"
            android:imeOptions="actionSend"
            android:inputType="textCapSentences|textMultiLine"
            android:maxLines="3" />
        <TextView
            android:id="@+id/envoyer"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="8dp"
            android:background="@drawable/cadre"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="➤"
            android:textColor="@color/vert"
            android:textSize="20sp"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>

    <fr.archi.telephone.EcranOeil
        android:id="@+id/ecran_oeil"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <fr.archi.telephone.Vague
        android:id="@+id/vague"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />
</FrameLayout>
