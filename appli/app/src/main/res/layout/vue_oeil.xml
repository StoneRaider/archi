<?xml version="1.0" encoding="utf-8"?>
<!-- L'ecran de l'oeil (gonfle dans EcranOeil) : le globe en plein ecran, un bandeau en haut, le bouton pour parler en bas. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- la toile du globe (WebView) est creee par EcranOeil.creerToile(), tout en dessous -->

    <!-- fine ligne de chargement, tout en haut -->
    <View
        android:id="@+id/jauge_oeil"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_gravity="top"
        android:background="@color/vert"
        android:transformPivotX="0dp"
        android:visibility="gone" />

    <!-- bandeau : ce qu'on regarde -->
    <LinearLayout
        android:id="@+id/bandeau_oeil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:background="@drawable/verre_haut"
        android:paddingStart="18dp"
        android:paddingEnd="10dp"
        android:paddingTop="10dp"
        android:paddingBottom="26dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="L’ŒIL"
                android:textColor="@color/vert"
                android:textSize="11sp"
                android:letterSpacing="0.3"
                android:typeface="monospace" />
            <TextView
                android:id="@+id/fermer_oeil"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="✕"
                android:textColor="@color/texte2"
                android:textSize="18sp"
                android:clickable="true"
                android:focusable="true"
                android:contentDescription="Fermer l’œil" />
        </LinearLayout>

        <TextView
            android:id="@+id/titre_oeil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/texte"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#CC0B1410"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/sous_titre_oeil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textColor="@color/texte2"
            android:textSize="12sp"
            android:typeface="monospace"
            android:maxLines="2"
            android:ellipsize="end"
            android:shadowColor="#CC0B1410"
            android:shadowRadius="6" />
    </LinearLayout>

    <!-- message au milieu (erreur, lien expire...) : un toucher l'enleve -->
    <TextView
        android:id="@+id/message_oeil"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="28dp"
        android:layout_marginEnd="28dp"
        android:background="@drawable/verre"
        android:padding="16dp"
        android:gravity="center"
        android:textColor="@color/texte"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- pied : ce qu'Archi dit, l'etat, le bouton pour parler -->
    <LinearLayout
        android:id="@+id/pied_oeil"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="22dp"
        android:background="@drawable/verre_bas">

        <TextView
            android:id="@+id/legende_oeil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/verre"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="9dp"
            android:paddingBottom="9dp"
            android:gravity="center"
            android:textColor="@color/texte"
            android:textSize="14sp"
            android:maxLines="4"
            android:ellipsize="end"
            android:visibility="gone" />

        <TextView
            android:id="@+id/etat_oeil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:textColor="@color/texte2"
            android:textSize="12sp"
            android:shadowColor="#CC0B1410"
            android:shadowRadius="6" />

        <fr.archi.telephone.BoutonOeil
            android:id="@+id/bouton_oeil"
            android:layout_width="74dp"
            android:layout_height="74dp" />
    </LinearLayout>
</merge>
