<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : ni sauvegarde cloud ni transfert d'appareil a appareil des reglages (cle du serveur). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
