<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#33FF6B5B" />
        </shape>
    </item>
    <item android:top="14dp" android:bottom="14dp" android:left="14dp" android:right="14dp">
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="140dp"
                android:startColor="#FF8A7D" android:endColor="#B23A2E" />
            <stroke android:width="2dp" android:color="#FFC2BA" />
        </shape>
    </item>
</layer-list>
