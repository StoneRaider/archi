# =====================================================================================================
#  ARCHI - LE SEUL FICHIER DE REGLAGES ET DE CLES
#  1. Copie ce fichier en .env (meme dossier).  2. Remplis ce qui te concerne.  3. Lance lancer_archi.bat.
#  Le .env n'est JAMAIS publie (.gitignore) et n'est jamais lu a voix haute ni envoye sur Telegram.
#  Laisse vide ce que tu n'utilises pas : l'outil concerne le dira simplement.
# =====================================================================================================

# ---------- 1. Toi et tes dossiers ----------
# Ton prenom (utilise dans les consignes du modele)
ARCHI_UTILISATEUR=Camille
# Le dossier de ce depot (clone)
ARCHI_DEPOT=
# (vide = le dossier ou se trouve lancer_archi.bat)
# Le chateau (memoire + outils). Vide = ~/.n8n-files
ARCHI_BASE=
# Python qui lance les outils (vide = celui du PATH)
ARCHI_PY=
# Fuseau horaire et pays (recherche d'adresses)
ARCHI_FUSEAU=Europe/Paris
ARCHI_PAYS=fr

# ---------- 2. Le cerveau : LM Studio ----------
ARCHI_LM_URL=http://127.0.0.1:1234/v1
ARCHI_MODELE=openai/gpt-oss-20b
ARCHI_MODELE_VISION=google/gemma-3-12b

# ---------- 3. Telegram (bot cree avec @BotFather) ----------
# Le jeton du bot (BotFather te le donne)
TELEGRAM_BOT_TOKEN=
# Ton numero de chat : SEUL ce chat parle a Archi (plusieurs : separes par des virgules)
ARCHI_TELEGRAM_CHAT_ID=
# Adresse HTTPS publique de n8n (ngrok, Tailscale Funnel...) : https://.../
WEBHOOK_URL=

# ---------- 4. L'appli Android ----------
# Cle partagee avec l'appli (32 caracteres aleatoires) :
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ARCHI_CLE_TELEPHONE=

# ---------- 5. Mails et agenda (serveur Python, voir serveur/LISEZMOI.md) ----------
# Fichier OAuth « application de bureau » de Google (vide = serveur/donnees/google_client.json)
ARCHI_GOOGLE_CLIENT=
# Outlook / Hotmail : ID d'application Azure ; tenant « consumers » pour un compte personnel
ARCHI_OUTLOOK_CLIENT_ID=
ARCHI_OUTLOOK_TENANT=consumers
# Tri des non lus : tri_auto (ranger) ou corbeille (jeter)
ARCHI_TRI_ACTION=tri_auto
ARCHI_SERVEUR_PORT=8765

# ---------- 5 bis. Enquetes OSINT (Hunter) et recherche web ----------
# Tavily (recherche et lecture de pages, offre gratuite sur tavily.com)
TAVILY_API_KEY=
# Hunter.io (emails publics d'une ENTREPRISE a partir de son domaine ; facultatif)
HUNTERIO_API_KEY=

# ---------- 5 ter. Brief du jour (serveur/brief.py, 14 h par defaut) ----------
# Lieux de la meteo :  Nom:lat,lon ; Nom:lat,lon   (vide = ta derniere position)
ARCHI_BRIEF_LIEUX=
# Flux d'actualite :  Nom|https://...rss|nombre ; ...   (vide = ReliefWeb)
ARCHI_BRIEF_FLUX=ReliefWeb|https://reliefweb.int/disasters/rss.xml|3
# Navigateur pilote par Archi (vide = Edge)
ARCHI_NAVIGATEUR=
# Heure du brief (format cron), vide = 8 h chaque jour
ARCHI_BRIEF_CRON=0 8 * * *
# Montage video : le jeu a ne pas ralentir (ex. MonJeu.exe) et le nom du groupe sur le carton de titre
ARCHI_MONTAGE_JEU=
ARCHI_MONTAGE_GROUPE=
# Python du serveur (vide = serveur/venv)
ARCHI_SERVEUR_PY=

# ---------- 6. L'Oeil (globe) et la boite Docker ----------
# Cle de la porte de l'oeil (32 caracteres aleatoires, meme commande que plus haut)
ARCHI_CLE_OEIL=
# Adresse publique de l'oeil pour le telephone (tunnel), ex. https://oeil.exemple.net
ARCHI_OEIL_URL_PUBLIQUE=
# Cles gratuites facultatives du globe
AISSTREAM_API_KEY=
FIRMS_MAP_KEY=
MAPILLARY_CLIENT_TOKEN=
# Tunnel Cloudflare (facultatif)
TUNNEL_TOKEN=
# Presenton (presentations) : le modele local
PRESENTON_URL=http://127.0.0.1:5001
LLM=custom
CUSTOM_LLM_URL=http://host.docker.internal:1234/v1
CUSTOM_MODEL=openai/gpt-oss-20b
PEXELS_API_KEY=

# ---------- 7. Cameras du reseau local (outil cameras) ----------
# Un code par camera, avec le nom donne dans « ajouter » (en majuscules), ex. pour la camera « entree » :
ARCHI_CAMERA_ENTREE_UTILISATEUR=admin
ARCHI_CAMERA_ENTREE_CODE=

# ---------- 8. Imprimante 3D ----------
# moonraker (Klipper : Creality K1/K2, Voron, Sovol...), octoprint ou prusalink
ARCHI_IMPRIMANTE_TYPE=moonraker
ARCHI_IMPRIMANTE_IP=
# Port (vide = celui par defaut) et cle API (OctoPrint, PrusaLink ; Moonraker : facultative)
ARCHI_IMPRIMANTE_PORT=
ARCHI_IMPRIMANTE_CLE=
# Ou chercher la camera de l'imprimante (3 premiers nombres du reseau)
ARCHI_IMPRIMANTE_RESEAUX=192.168.1
# OpenSCAD (conception de pieces) si absent du PATH
ARCHI_OPENSCAD=

# ---------- 9. Musique, voix, alertes ----------
# Dossiers de musique a indexer (lecture seule), separes par ;
ARCHI_MUSIQUE=
# Dossier de whisper.cpp (voix -> texte)
ARCHI_WHISPER_DIR=
# Micro a ecouter (python pc/voix/ecoute.py liste) ; vide = le premier
ECOUTE_MICRO=
# Webhook n8n LOCAL qui relaie les alertes (Polymarket, video analysee) sur Telegram
ARCHI_WEBHOOK_ALERTE=
# Tes centres d'interet (fiches de la bibliotheque : « utile pour moi »), ex. jardinage, velo, electronique
ARCHI_CENTRES_INTERET=
# Regions qui declenchent une alerte Polymarket (en anglais), ex. belgium,quebec
ARCHI_REGIONS_ALERTE=

# ---------- 10. n8n (ne pas changer) ----------
NODE_FUNCTION_ALLOW_BUILTIN=child_process,fs,path,os,crypto,process
N8N_BLOCK_ENV_ACCESS_IN_NODE=false
N8N_PORT=5678
# Version de n8n lancee par lancer_archi.bat (1 = la serie 1.x, celle avec laquelle Archi a ete fait)
ARCHI_N8N_VERSION=1
# n8n 2.x desactive par defaut le noeud « Execute Command » (workflows 3D optionnels) : cette ligne le reactive
NODES_EXCLUDE=[]
